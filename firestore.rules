rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth()       { return request.auth != null; }
    function userData()     { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function hasUserDoc()   { return isAuth() && exists(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function isActivo()     { return hasUserDoc() && userData().activo == true; }
    function isDirectorio() { return isActivo() && userData().rol in ['directorio','superadmin']; }
    function isSuperadmin() {
      return isActivo()
        && userData().rol == 'superadmin'
        && request.auth.token.email.matches('.*@micorriza\\.bio$');
    }
    function isOwner(uid)   { return isAuth() && request.auth.uid == uid; }
    // Cuentas de administración/pruebas: no son socios y no emiten Poder Simple
    function esCuentaMicorriza() {
      return isAuth() && request.auth.token.email.matches('.*@micorriza\\.bio$');
    }
    function emailToken()   { return request.auth.token.email.lower(); }
    // El rol superadmin es EXCLUSIVO de cuentas @micorriza.bio
    function rolValido(data) {
      return data.rol != 'superadmin'
        || data.email.matches('.*@micorriza\\.bio$');
    }

    /* ════════════════ PERMISOS POR CARGO ════════════════
       El rol dice quién entra al panel del Directorio; el CARGO dice qué puede
       hacer dentro. La matriz vive en config/permisos y la edita únicamente el
       superadmin, de modo que el Tesorero administre finanzas y padrón, el
       Secretario lleve actas y comunicaciones y el Presidente vea todo.

       Mientras `activo` sea false (o el documento no exista), rige el
       comportamiento histórico: todo el Directorio puede todo. Así la
       migración nunca deja al gremio sin poder operar.
    ════════════════════════════════════════════════════════ */
    function cfgPermisos() { return /databases/$(database)/documents/config/permisos; }

    function hayControlPorCargo() {
      return exists(cfgPermisos())
        && get(cfgPermisos()).data.get('activo', false) == true;
    }

    // Lista de permisos del cargo de quien hace la petición.
    function permisosDelUsuario() {
      return get(cfgPermisos()).data
        .get('matriz', {})
        .get(userData().get('cargoKey', 'sin-cargo'), []);
    }

    function puede(permiso) {
      return isSuperadmin()
        || (isDirectorio()
            && (!hayControlPorCargo() || permisosDelUsuario().hasAny([permiso])));
    }

    match /users/{uid} {
      // Socios solo leen su propio doc; quien tenga padron.ver lista todos
      allow get:  if isOwner(uid) || puede('padron.ver');
      allow list: if puede('padron.ver');
      // Inscribir socios: solo con padron.gestionar y siempre con rol 'socio'
      allow create: if puede('padron.gestionar')
        && request.resource.data.rol == 'socio';
      // Solo el superadmin crea con cualquier rol (superadmin solo @micorriza.bio)
      allow create: if isSuperadmin() && rolValido(request.resource.data);
      // Se editan datos básicos, pero NUNCA rol, activo ni el cargo: el cargo
      // determina los permisos, así que cambiarlo es prerrogativa del superadmin
      // (si no, un directivo podría auto-asignarse el cargo de Tesorero).
      allow update: if puede('padron.gestionar')
        && !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['rol', 'activo', 'cargo', 'cargoKey']);
      // Cambio de rol, de cargo y activar/desactivar: SOLO superadmin
      allow update: if isSuperadmin() && rolValido(request.resource.data);
      // Renuncia y reincorporación: baja del gremio registrada por el padrón.
      // 'activo' debe ser coherente con 'estadoSocio' (renunciado → false,
      // activo → true); desactivar arbitrario sigue siendo del superadmin.
      allow update: if puede('padron.gestionar')
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['estadoSocio', 'fechaRenuncia', 'motivoRenuncia', 'fechaReincorporacion', 'activo'])
        && request.resource.data.estadoSocio in ['activo', 'renunciado']
        && request.resource.data.activo == (request.resource.data.estadoSocio == 'activo');
      // Bootstrap del primer superadmin: una cuenta @micorriza.bio se crea a sí misma
      allow create: if isOwner(uid)
        && request.auth.token.email.matches('.*@micorriza\\.bio$')
        && request.resource.data.rol == 'superadmin'
        && request.resource.data.email == request.auth.token.email;
      // Un pre-inscrito reclama su ficha al primer login, con el rol que el
      // superadmin haya pre-asignado en padronPendiente (por defecto 'socio')
      allow create: if isOwner(uid)
        && exists(/databases/$(database)/documents/padronPendiente/$(emailToken()))
        && request.resource.data.email == emailToken()
        && request.resource.data.rol ==
             get(/databases/$(database)/documents/padronPendiente/$(emailToken()))
               .data.get('rolAsignado', 'socio');
      // Socio puede actualizar solo sus flags personales.
      // loginCount solo puede crecer de a 1 (estadística de uso no falseable).
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['ultimoLogin','onboardingOk','terminosAceptados','loginCount'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['loginCount'])
            || request.resource.data.loginCount == resource.data.get('loginCount', 0) + 1);
      allow delete: if false;
    }

    // Fichas pre-inscritas, a la espera del primer login (Google o Microsoft)
    match /padronPendiente/{email} {
      allow read, delete: if puede('padron.gestionar');
      // Quien administra el padrón inscribe socios pero NO pre-asigna roles superiores
      allow create, update: if puede('padron.gestionar')
        && (!('rolAsignado' in request.resource.data)
            || request.resource.data.rolAsignado == 'socio');
      // Solo el superadmin pre-asigna rol directorio (prerrogativa de roles)
      allow create, update: if isSuperadmin()
        && (!('rolAsignado' in request.resource.data)
            || request.resource.data.rolAsignado in ['socio', 'directorio']);
      // El propio socio lee su ficha al reclamarla (eliminarla es solo del directorio)
      allow get: if isAuth() && emailToken() == email;
    }

    match /movimientos/{id} {
      // Transparencia: todo socio activo lee el libro de caja
      allow read:  if isActivo();
      allow write: if puede('finanzas.gestionar');
    }

    match /votaciones/{id} {
      allow read:           if isActivo();
      allow create, delete: if puede('votaciones.gestionar');
      // Gestión de la votación con el permiso correspondiente. Un socio solo
      // puede tocar 'opciones' UNA vez: en la misma transacción que crea su
      // registro de votante (existsAfter), con la votación abierta, sin haber
      // votado antes y sin alterar el número de opciones. Sin esto, cualquier
      // socio podía reescribir el escrutinio ilimitadamente desde la consola.
      allow update: if puede('votaciones.gestionar')
        || (isActivo()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['opciones'])
            && resource.data.estado == 'abierta'
            && request.resource.data.opciones.size() == resource.data.opciones.size()
            && !exists(/databases/$(database)/documents/votantes/$(id + '_' + request.auth.uid))
            && existsAfter(/databases/$(database)/documents/votantes/$(id + '_' + request.auth.uid)));
    }

    match /votantes/{votoId} {
      // Cada socio solo puede consultar SU voto (ID compuesto votacionId_uid)
      allow get:  if puede('votaciones.gestionar') || (isAuth() && votoId.matches('.*_' + request.auth.uid));
      allow list: if puede('votaciones.gestionar');
      allow create: if isActivo()
        && request.resource.data.uid == request.auth.uid
        && votoId == request.resource.data.votacionId + '_' + request.auth.uid;
      allow update, delete: if false;
    }

    match /poderes/{id} {
      // Dato personal sensible: se ve con poderes.ver o siendo el titular
      allow read: if puede('poderes.ver')
        || (isActivo() && resource.data.uid == request.auth.uid);
      allow create: if isActivo()
        && request.resource.data.uid == request.auth.uid
        && !esCuentaMicorriza();
      allow update: if (isActivo() && resource.data.uid == request.auth.uid)
        || puede('poderes.gestionar');
      allow delete: if false;
    }

    match /actas/{id} {
      allow read: if isDirectorio()
        || (isActivo() && resource.data.publicada == true);
      allow write: if puede('actas.gestionar');
    }

    match /mensajes/{id} {
      // El buzón de socios se lee con buzon.ver; cada socio ve lo suyo
      allow read: if puede('buzon.ver')
        || (isActivo() && resource.data.autorUid == request.auth.uid);
      // Sin suplantación: el nombre debe ser el de la ficha (o Anónimo/a),
      // los recordatorios automáticos solo los crea el directorio, y el
      // mensaje tiene largo acotado.
      allow create: if isActivo()
        && request.resource.data.autorUid == request.auth.uid
        && request.resource.data.mensaje is string
        && request.resource.data.mensaje.size() > 0
        && request.resource.data.mensaje.size() <= 3000
        && (
             (request.resource.data.get('esRecordatorio', false) == true && isDirectorio())
          || (request.resource.data.get('esRecordatorio', false) == false
              && request.resource.data.autorNombre ==
                   (request.resource.data.anonimo == true ? 'Anónimo/a' : userData().nombre))
        );
      allow update: if puede('buzon.ver');
      allow delete: if false;
    }

    // Historial de pagos de cuotas por socio (ID determinístico uid_YYYY-MM)
    match /pagosCuotas/{pagoId} {
      // El socio consulta sus propios pagos; el directorio los consulta todos
      allow get, list: if isDirectorio()
        || (isActivo() && resource.data.uid == request.auth.uid);
      // Registrar y borrar pagos es materia de Tesorería
      allow create, update: if puede('finanzas.gestionar')
        && pagoId == request.resource.data.uid + '_' + request.resource.data.mes
        && request.resource.data.monto is int
        && request.resource.data.monto >= 0;
      allow delete: if puede('finanzas.gestionar');
    }

    match /notificaciones/{id} {
      allow read:  if isActivo();
      // Publicaciones del Diario Mural con largo acotado (título 200, cuerpo 6000)
      allow create: if puede('mural.publicar')
        && request.resource.data.titulo is string
        && request.resource.data.titulo.size() <= 200
        && request.resource.data.cuerpo is string
        && request.resource.data.cuerpo.size() <= 6000;
      allow update, delete: if puede('mural.publicar');
    }

    // Mensajería in-app del directorio/superadmin hacia socios
    match /mensajesDirectorio/{id} {
      // El destinatario lee los suyos; quien envía comunicados los lee todos
      allow read: if puede('mensajeria.enviar')
        || (isActivo() && resource.data.paraUid == request.auth.uid);
      // Solo con mensajeria.enviar, y con largos acotados
      allow create: if puede('mensajeria.enviar')
        && request.resource.data.deUid == request.auth.uid
        && request.resource.data.asunto is string
        && request.resource.data.asunto.size() <= 200
        && request.resource.data.mensaje is string
        && request.resource.data.mensaje.size() <= 6000;
      // El destinatario solo puede marcar como leído
      allow update: if isActivo()
        && resource.data.paraUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['leido']);
      allow delete: if puede('mensajeria.enviar');
    }

    match /eventos/{id} {
      allow read:  if isActivo();
      allow write: if puede('calendario.gestionar');
    }

    match /beneficios/{id} {
      allow read:  if isActivo();
      allow write: if puede('beneficios.gestionar');
    }

    match /auditLog/{id} {
      // El superadmin siempre; el Directorio, con el permiso de auditoría
      allow read:   if isSuperadmin() || puede('auditoria.ver');
      // La identidad del registro debe salir del token (no falseable) y los
      // campos de texto tienen largo acotado.
      allow create: if isActivo()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.userEmail == request.auth.token.email
        && request.resource.data.keys().hasOnly(
             ['uid','userEmail','userNombre','accion','coleccion','documentoId','detalle','creadoEn'])
        && request.resource.data.accion is string
        && request.resource.data.accion.size() <= 64
        && (!('userNombre' in request.resource.data)
            || request.resource.data.userNombre == null
            || (request.resource.data.userNombre is string && request.resource.data.userNombre.size() <= 120))
        && (!('coleccion' in request.resource.data)
            || request.resource.data.coleccion == null
            || (request.resource.data.coleccion is string && request.resource.data.coleccion.size() <= 60));
      allow update, delete: if false;
    }

    match /config/{id} {
      allow read:  if isActivo();
      // La matriz de permisos es prerrogativa EXCLUSIVA del superadmin: si el
      // Directorio pudiera editarla, el control por cargo sería decorativo
      // (cualquiera se concedería finanzas). El valor de las cuotas es de
      // Tesorería, y el resto de la configuración sigue siendo del Directorio.
      allow write: if (id == 'permisos' && isSuperadmin())
        || (id == 'cuotas' && puede('cuotas.configurar'))
        || (id != 'permisos' && id != 'cuotas' && isDirectorio());
    }

    // Padrón gestionado desde la app React (colección separada de /users)
    match /socios/{id} {
      allow read:  if isActivo();
      allow write: if puede('padron.gestionar');
    }

    // Buzón de soporte: socios crean tickets y leen los suyos; el Directorio
    // los gestiona con el mismo permiso que el buzón general.
    match /tickets/{id} {
      allow get:    if puede('buzon.ver')
        || (isActivo() && resource.data.uid == request.auth.uid);
      allow list:   if puede('buzon.ver');
      allow create: if isActivo()
        && request.resource.data.uid == request.auth.uid;
      allow update: if puede('buzon.ver');
      allow delete: if false;
    }
  }
}
